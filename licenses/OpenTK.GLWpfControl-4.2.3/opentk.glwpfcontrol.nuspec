<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/10/nuspec.xsd">
  <metadata>
    <id>OpenTK.GLWpfControl</id>
    <version>4.2.3</version>
    <title>OpenTK.GLWpfControl</title>
    <authors>varon NogginBops</authors>
    <owners>varon NogginBops</owners>
    <licenseUrl>https://github.com/varon/GLWpfControl/blob/master/LICENSE.md</licenseUrl>
